# مثال آمن لمتغيرات بيئة KMT OMS Backend - لا تضع قيما حقيقية هنا.
NODE_ENV=development

# إعدادات قاعدة البيانات - استخدم قيما حقيقية فقط في لوحة الاستضافة أو ملف .env المحلي غير المتتبع.

PORT=5000
TRUST_PROXY=1
DB_HOST=sakura.proxy.rlwy.net
DB_PORT=43738
DB_USER=root
DB_ROOT_PASSWORD=IcNEgRqibhtnxVPNjpXLMdzLykWOsmgC
DB_PASS=IcNEgRqibhtnxVPNjpXLMdzLykWOsmgC
DB_NAME=railway

# سر JWT يجب توليده بقيمة عشوائية قوية وعدم حفظه في git.
JWT_SECRET=replace_with_crypto_random_64_bytes_hex

# أصول الواجهة المسموحة مفصولة بفواصل، ويجب استخدام أسماء نطاقات كاملة في الإنتاج.
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# إعدادات ERP الاختيارية.
ERP_BASE_URL=https://example-erp.local/api/v3
ERP_ALLOWED_HOSTS=example-erp.local
ERP_SETTINGS_ENCRYPTION_KEY=fad579ddea90f8160a55f53a1dfe72b94bde5ac6b021692973e45ca46fdc4900
ALLOW_ERP_CREDENTIALS_IN_BODY=false
ENABLE_MOCK_ERP_SYNC=false

# إعدادات التخزين والنسخ الاحتياطي الاختيارية.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_DELETE_LOCAL_AFTER_UPLOAD=false